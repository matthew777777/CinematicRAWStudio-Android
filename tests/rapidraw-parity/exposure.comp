layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Inputs { vec4 inputs[]; };
layout(set = 0, binding = 1, std430) buffer Outputs { vec4 outputs[]; };

vec3 apply_linear_exposure(vec3 color_in, float exposure_adj) {
    if (exposure_adj == 0.0) {
        return color_in;
    }
    return color_in * pow(2.0, exposure_adj);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= inputs.length()) return;
    outputs[i] = vec4(apply_linear_exposure(inputs[i].xyz, inputs[i].w), inputs[i].w);
}
